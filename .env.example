# --- Obrigatório ---------------------------------------------------------
# Quem recebe a mensagem diária. Use o nome exatamente como aparece na lista
# de conversas do TikTok. Vários destinatários: separe por vírgula.
TIKTOK_TARGETS=

# Mensagens possíveis, separadas por "|". Uma é sorteada a cada envio.
TIKTOK_MESSAGES=🔥|🔥🔥|oi|bom dia

# --- Navegador -----------------------------------------------------------
# Canal do Chromium instalado na máquina: msedge, chrome ou vazio para usar
# o Chromium que vem com o Playwright (npm run setup).
BROWSER_CHANNEL=msedge

# Deixe false até confirmar que funciona; depois mude para true nas execuções
# agendadas, que ficam bem mais rápidas sem interface.
HEADLESS=false

# Pasta onde a sessão logada fica salva. Nunca versione.
BROWSER_PROFILE_DIR=.profile

# --- Tempos --------------------------------------------------------------
TIMEOUT_MS=45000
DELAY_MIN_MS=1500
DELAY_MAX_MS=4000

# --- Diagnóstico ---------------------------------------------------------
# true abre a conversa mas não envia nada: útil para testar a configuração.
DRY_RUN=false
SCREENSHOT_DIR=logs

# --- URLs (raramente precisa mexer) --------------------------------------
TIKTOK_MESSAGES_URL=https://www.tiktok.com/messages?lang=pt-BR
TIKTOK_LOGIN_URL=https://www.tiktok.com/login?lang=pt-BR
